{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "otb-role-intelligence",
  "main": "./worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Browser Run allowance tuning (Workers Paid).
    // Paid raises the instance fill rate from 3/min to 10/min — still a fill
    // rate, so roughly one call every 6s. 2500ms tripped the limiter on free.
    "BROWSER_MIN_SPACING_MS": "6000",
    // Coverage builds across scans via the article cache, so this does not need
    // to cover every candidate in one run.
    "BROWSER_BUDGET": "6",
    // 6 calls at 6s spacing plus render time. 90000 was measured hitting the
    // wall at 93.2s with 3 articles unread on a cold cache, so 120s it is.
    // A cold scan only happens after a CACHE_FORMAT bump; warm scans finish
    // in well under half this.
    "SCAN_BUDGET_MS": "120000",
    // Clubs refreshed per cron tick. 0 genuinely disables the sweep (fixed in
    // v1.8 — the previous expression silently forced a minimum of 1).
    "CRON_TEAMS_PER_RUN": "2",
    // CORS. Replace with your actual Pages origin. Requests with no Origin
    // header (address bar, curl) are still allowed so debugging works.
    "ALLOWED_ORIGIN": "https://blackpharoahisking-gif.github.io",
    // Cost controls on public forced scans.
    "FORCE_COOLDOWN_MINUTES": "2",
    "FORCE_DAILY_CAP": "60",
    // Articles read per scan before scoring cuts the list off.
    "MAX_ARTICLES_PER_SCAN": "8",
    // How long a cached report is served before a background refresh fires.
    "STALE_AFTER_MINUTES": "360",
    // Carry-forward window for evidence when a scan cannot read its sources.
    "MAX_CARRY_DAYS": "7"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otb-role-graph",
      "database_id": "229e216a-6db2-4b64-bcff-d492b93e6bd8"
    }
  ],
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "triggers": { "crons": ["*/30 * * * *"] }
}
